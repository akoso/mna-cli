{
  "name": "@mantacodedevs/mna-cli",
  "version": "0.3.1",
  "description": "Command-line tool for My Next Adventure trip planning.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/MantaCodeDevs/mna-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MantaCodeDevs/mna-cli.git"
  },
  "bugs": {
    "url": "https://github.com/MantaCodeDevs/mna-cli/issues"
  },
  "keywords": [
    "cli",
    "travel",
    "trip-planning",
    "my-next-adventure",
    "claude-code-skill"
  ],
  "bin": {
    "mna": "./dist/mna.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/mna.js",
    "skills/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/bin/mna.ts --target=node --outdir=dist --format=esm && bun run scripts/postbuild.ts",
    "build:binaries": "scripts/build-binaries.sh",
    "codegen": "bun run scripts/codegen.ts",
    "dev": "bun run src/bin/mna.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "citty": "^0.1.6",
    "jsonc-parser": "^3.3.1",
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.1.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  }
}
