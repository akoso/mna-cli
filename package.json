{
    "name": "@mynextadventure/cli",
    "version": "0.0.1",
    "description": "Command-line tool for My Next Adventure trip planning.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "mna": "./src/bin/mna.ts"
    },
    "files": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "skills/**",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "bun build src/bin/mna.ts --target=bun --outdir=dist",
        "codegen": "bun run scripts/codegen.ts",
        "dev": "bun run src/bin/mna.ts",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "lint:fix": "biome check --write .",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "citty": "^0.1.6",
        "openapi-fetch": "^0.13.0",
        "@inquirer/prompts": "^7.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.0",
        "@types/bun": "^1.1.0",
        "openapi-typescript": "^7.4.0",
        "typescript": "^5.6.0"
    }
}
